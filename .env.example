# Bademcioğlu Yoğurtları — Ortam Değişkenleri Şablonu (.env.example)
# Gerçek değerlerinizi .env.local dosyasına veya Vercel panelindeki Environment Variables alanına yazınız.

NEXT_PUBLIC_ADMIN_USERNAME=ornek_kullanici_adi
NEXT_PUBLIC_ADMIN_PIN=ornek_guclu_sifre_buraya

# Supabase Veritabanı Yapılandırması (https://supabase.com)
# Supabase Dashboard -> Project Settings -> API bölümünden temin edebilirsiniz:
NEXT_PUBLIC_SUPABASE_URL=https://proje-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
